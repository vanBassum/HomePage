{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,

    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "emitDeclarationOnly": false
  },
  "include": ["**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
