{
    "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "Bundler",
  
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
  
      "types": ["node"],
  
      "baseUrl": ".",
      "paths": {
        "@shared/*": ["../shared/*"]
      },
  
      "outDir": "dist"
    },
    "include": ["src/**/*.ts", "../shared/**/*.ts"]
  }
  