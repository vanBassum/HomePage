{
  "private": true,
  "workspaces": ["shared", "client", "server"],
  "scripts": {
    "dev": "npm-run-all -p shared:watch server:dev client:dev",
    "shared:watch": "npm --prefix shared run watch",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "build": "npm --prefix shared run build && npm --prefix client run build && npm --prefix server run build"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
